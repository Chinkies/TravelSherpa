<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/item_user_photo"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/default_user"
        tools:src="@tools:sample/avatars"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/item_user_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_weight="1"
        android:text="Pseudo de l'admin"
        android:textStyle="bold"
        tools:text="Pseudo d'un admin"
        app:layout_constraintBottom_toBottomOf="@+id/item_user_photo"
        app:layout_constraintStart_toEndOf="@+id/item_user_photo"
        app:layout_constraintTop_toTopOf="@+id/item_user_photo" />

    <ImageButton
        android:id="@+id/item_user_delete"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="bouton pour supprimer un admin"
        android:scaleType="fitCenter"
        android:src="@drawable/supprimer"
        app:layout_constraintBottom_toBottomOf="@+id/item_user_photo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/item_user_photo" />
</androidx.constraintlayout.widget.ConstraintLayout>
