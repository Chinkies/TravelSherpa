<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/btnSauvegarder">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imgBanner"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ballon_voyage_recherrche_default" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@android:color/white"
                android:elevation="2dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:id="@+id/textTitreParcours"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_toStartOf="@id/layoutActions"
                        android:text="Nom du parcours"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#333333"/>

                    <LinearLayout
                        android:id="@+id/layoutActions"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:orientation="horizontal">
                        <ImageView
                            android:id="@+id/btnPartager"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@android:drawable/ic_menu_share"
                            android:layout_marginEnd="12dp"
                            app:tint="#E67E22"/>
                        <ImageView
                            android:id="@+id/btnExportPdf"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@android:drawable/ic_menu_save"
                            app:tint="#E67E22"/>
                    </LinearLayout>
                </RelativeLayout>

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:columnCount="2">

                    <TextView
                        android:id="@+id/valBudget"
                        android:layout_columnWeight="1"
                        android:text="Budget: --"
                        android:textSize="13sp"
                        android:drawableStart="@android:drawable/ic_menu_gallery"
                        android:drawablePadding="6dp" />
                    <TextView
                        android:id="@+id/valDuree"
                        android:layout_columnWeight="1"
                        android:text="Durée: --"
                        android:textSize="13sp"
                        android:drawableStart="@android:drawable/ic_menu_recent_history"
                        android:drawablePadding="6dp" />
                    <TextView
                        android:id="@+id/valEffort"
                        android:layout_columnWeight="1"
                        android:layout_marginTop="8dp"
                        android:text="Effort: --"
                        android:textSize="13sp"
                        android:drawableStart="@android:drawable/ic_menu_manage"
                        android:drawablePadding="6dp" />
                    <TextView
                        android:id="@+id/valLieux"
                        android:layout_columnWeight="1"
                        android:layout_marginTop="8dp"
                        android:text="Lieux: --"
                        android:textSize="13sp"
                        android:drawableStart="@android:drawable/ic_menu_mylocation"
                        android:drawablePadding="6dp" />
                </GridLayout>
            </LinearLayout>

            <org.osmdroid.views.MapView
                android:id="@+id/mapView"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="4dp" />
            <TextView
                android:id="@+id/textPlanVoyage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="16dp"
                android:paddingBottom="8dp"
                android:paddingLeft="16dp"
                android:text="PLAN DE VOYAGE"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="#555555" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewEtapes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <Button
        android:id="@+id/btnSauvegarder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_margin="16dp"
        android:backgroundTint="#2C3E50"
        android:text="SAUVEGARDER LE PARCOURS"
        android:textColor="#FFFFFF"
        app:cornerRadius="12dp" />

</RelativeLayout>
