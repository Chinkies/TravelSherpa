<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:layout_marginEnd="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <ImageView
            android:id="@+id/add_group_profil_picture"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:contentDescription="Profil picture"
            android:scaleType="centerCrop"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:srcCompat="@tools:sample/avatars" />

        <TextView
            android:id="@+id/add_group_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:text="Nom du groupe"
            android:textStyle="bold"
            tools:text="Un nom de groupe"
            app:layout_constraintBottom_toBottomOf="@+id/add_group_profil_picture"
            app:layout_constraintStart_toEndOf="@+id/add_group_profil_picture"
            app:layout_constraintTop_toTopOf="@+id/add_group_profil_picture" />

        <ImageButton
            android:id="@+id/add_group_delete"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="bouton pour supprimer un admin"
            android:scaleType="fitCenter"
            android:src="@drawable/supprimer"
            app:layout_constraintBottom_toBottomOf="@+id/add_group_profil_picture"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/add_group_profil_picture" />


    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>