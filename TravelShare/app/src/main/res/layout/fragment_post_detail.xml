<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".view.fragments.detail.PostDetailFragment">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/post_detail_scrollview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/comment_input_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/post_detail_profil_picture"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="Profil picture"
                    android:scaleType="centerCrop"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:srcCompat="@tools:sample/avatars" />

                <TextView
                    android:id="@+id/post_detail_pseudo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Pseudo utilisateur"
                    android:textColor="#333333"
                    android:textStyle="bold"
                    app:layout_constraintStart_toEndOf="@+id/post_detail_profil_picture"
                    app:layout_constraintTop_toTopOf="@+id/post_detail_profil_picture" />

                <TextView
                    android:id="@+id/post_detail_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Il y a 2 heures"
                    android:textColor="#757575"
                    android:textSize="12sp"
                    app:layout_constraintStart_toStartOf="@+id/post_detail_pseudo"
                    app:layout_constraintTop_toBottomOf="@+id/post_detail_pseudo" />

                <ImageButton
                    android:id="@+id/post_detail_btn_more"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="bouton plus d'option"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    app:layout_constraintBottom_toBottomOf="@+id/post_detail_profil_picture"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/post_detail_profil_picture"
                    app:srcCompat="@drawable/baseline_more_horiz" />

                <ImageView
                    android:id="@+id/post_detail_picture"
                    android:layout_width="0dp"
                    android:layout_height="250dp"
                    android:layout_marginTop="12dp"
                    android:scaleType="centerCrop"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/post_detail_profil_picture"
                    tools:srcCompat="@tools:sample/backgrounds/scenic" />

                <TextView
                    android:id="@+id/post_description"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="#333333"
                    android:text="Description du post..."
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/post_detail_picture" />

                <LinearLayout
                    android:id="@+id/linearLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/post_description">

                    <ImageButton
                        android:id="@+id/post_detail_btn_like"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_marginEnd="6dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="bouton pour like"
                        android:scaleType="fitCenter"
                        app:srcCompat="@drawable/like_heart" />

                    <TextView
                        android:id="@+id/post_detail_likes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:text="0 likes"
                        android:textColor="#333333"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/post_detail_btn_comment"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_marginEnd="6dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="bouton pour commenter"
                        android:scaleType="fitCenter"
                        app:srcCompat="@drawable/comment" />

                    <TextView
                        android:id="@+id/post_detail_comment"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 commentaires"
                        android:textColor="#333333"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <ImageButton
                        android:id="@+id/post_detail_btn_adresse"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="bouton pour l'adresse"
                        android:scaleType="fitCenter"
                        android:src="@drawable/adresse" />

                </LinearLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/post_detail_information"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/linearLayout">

                    <TextView
                        android:id="@+id/post_detail_date_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Date :"
                        android:textColor="#333333"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/post_detail_date_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="--"
                        android:textColor="#333333"
                        app:layout_constraintBaseline_toBaselineOf="@id/post_detail_date_label"
                        app:layout_constraintStart_toEndOf="@id/post_detail_date_label" />

                    <TextView
                        android:id="@+id/post_detail_location_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Position :"
                        android:textColor="#333333"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/post_detail_date_label" />

                    <TextView
                        android:id="@+id/post_detail_location_value"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="--"
                        android:textColor="#333333"
                        app:layout_constraintBaseline_toBaselineOf="@id/post_detail_location_label"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/post_detail_location_label" />

                    <TextView
                        android:id="@+id/post_detail_indications_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Indication :"
                        android:textColor="#333333"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/post_detail_location_label" />

                    <TextView
                        android:id="@+id/post_detail_indications_value"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="--"
                        android:textColor="#333333"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/post_detail_indications_label" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/post_detail_btn_view_lieu"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="GÉNÉRER UN PARCOURS VERS CE LIEU"
                        android:textColor="#E67E22"
                        android:visibility="visible"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/post_detail_indications_value"
                        app:strokeColor="#E67E22" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <View
                android:id="@+id/post_detail_separator"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:background="#FFA500" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/post_detail_comment_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:itemCount="5"
                tools:listitem="@layout/item_comment" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/comment_input_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <EditText
            android:id="@+id/post_detail_comment_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="Ajouter un commentaire..."
            android:textColor="#333333"
            android:textColorHint="#999999"
            android:inputType="textMultiLine"
            android:maxLines="3"
            android:padding="12dp" />

        <ImageButton
            android:id="@+id/post_detail_btn_send"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Envoyer le commentaire"
            android:src="@android:drawable/ic_menu_send"
            app:tint="#FFA500" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>