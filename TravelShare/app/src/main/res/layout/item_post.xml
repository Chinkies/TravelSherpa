<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:layout_marginEnd="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <ImageView
            android:id="@+id/post_profil_picture"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="Profil picture"
            android:scaleType="centerCrop"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:srcCompat="@tools:sample/avatars" />

        <TextView
            android:id="@+id/post_pseudo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Pseudo utilisateur"
            android:textStyle="bold"
            tools:text="Un pseudo quelconque"
            app:layout_constraintStart_toEndOf="@+id/post_profil_picture"
            app:layout_constraintTop_toTopOf="@+id/post_profil_picture" />

        <TextView
            android:id="@+id/post_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Il y a 2 heures"
            android:textColor="#757575"
            android:textSize="12sp"
            tools:text="Il y a 2 heures"
            app:layout_constraintStart_toStartOf="@+id/post_pseudo"
            app:layout_constraintTop_toBottomOf="@+id/post_pseudo" />

        <ImageButton
            android:id="@+id/btn_more"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="bouton plus d'option"
            android:padding="6dp"
            android:scaleType="fitCenter"
            app:layout_constraintBottom_toBottomOf="@+id/post_profil_picture"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/post_profil_picture"
            app:srcCompat="@drawable/baseline_more_horiz" />

        <ImageView
            android:id="@+id/post_picture"
            android:layout_width="0dp"
            android:layout_height="250dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            android:scaleType="centerCrop"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/post_profil_picture"
            app:layout_constraintTop_toBottomOf="@+id/post_profil_picture"
            tools:srcCompat="@tools:sample/backgrounds/scenic" />

        <TextView
            android:id="@+id/post_description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="C'était un voyage magnifique au bord de la mer..."
            tools:text="C'était un voyage magnifique au bord de la mer..."
            app:layout_constraintEnd_toEndOf="@+id/post_picture"
            app:layout_constraintStart_toStartOf="@+id/post_picture"
            app:layout_constraintTop_toBottomOf="@+id/post_picture" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="@+id/post_description"
            app:layout_constraintStart_toStartOf="@+id/post_picture"
            app:layout_constraintTop_toBottomOf="@+id/post_description">

            <ImageButton
                android:id="@+id/post_btn_like"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginEnd="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="bouton pour like"
                android:scaleType="fitCenter"
                app:srcCompat="@drawable/like_heart" />

            <TextView
                android:id="@+id/post_likes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:text="21 likes"
                android:textStyle="bold"
                tools:text="21 likes"/>

            <ImageButton
                android:id="@+id/post_btn_comment"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginEnd="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="bouton pour commenter"
                android:scaleType="fitCenter"
                app:srcCompat="@drawable/comment" />

            <TextView
                android:id="@+id/post_comment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12 commentaires"
                android:textStyle="bold"
                tools:text="12 commentaires"/>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>